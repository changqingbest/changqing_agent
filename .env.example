# 千问百炼配置。若系统中已有 DASHSCOPE_API_KEY，则这里无需重复填写。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 可选：其他 OpenAI 兼容服务。配置后优先级高于上面的千问配置。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# 可选：配置后 web_search 使用 Tavily；留空时自动使用免密钥 Bing RSS 搜索。
TAVILY_API_KEY=

HOST=127.0.0.1
PORT=8008
SYSTEM_PROMPT=你是常青 Agent。回答准确、简洁；需要时主动调用工具。

# 日志配置：级别、单文件滚动大小（字节）与保留份数。
# LOG_DIR 不设置时默认写入项目内 logs 目录；如需指定请写绝对路径。
LOG_LEVEL=INFO
# LOG_DIR=D:\daima\changqing_agent\logs
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
